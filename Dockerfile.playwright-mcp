FROM node:22-slim

WORKDIR /app

RUN npm install @playwright/mcp playwright --no-audit --no-fund && \
    npx playwright install chromium && \
    npm cache clean --force

EXPOSE 8931

CMD ["npx", "playwright-mcp", "--port", "8931", "--host", "0.0.0.0", "--allowed-hosts", "*", "--browser", "chromium"]
