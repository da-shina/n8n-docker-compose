# n8n environment variables
# Copy this file to .env and fill in the required secrets.

# Required: replace with a secure random value (openssl rand -hex 32)
N8N_ENCRYPTION_KEY=

# n8n image version. Must be identical for n8n and n8n-runners.
# Pin a real version for reproducible deployments instead of using latest.
N8N_VERSION=2.46.6

# Optional: Set timezone (e.g., Europe/Berlin, America/New_York)
TZ=Asia/Tokyo
# Keep this in sync with TZ
GENERIC_TIMEZONE=Asia/Tokyo

# Multi-user authentication settings
# N8N_USER_MANAGEMENT_JWT_SECRET is derived from N8N_ENCRYPTION_KEY in docker-compose.yml
N8N_USER_MANAGEMENT_DISABLED=false

# Enable/disable community nodes
N8N_COMMUNITY_NODES_ENABLED=true

# Community packages to install. Comma-separated for multiple packages.
N8N_COMMUNITY_PACKAGES=n8n-nodes-playwright,@n8n/n8n-nodes-langchain

# Allow community packages to use tools
N8N_COMMUNITY_PACKAGES_ALLOW_TOOL_USAGE=true

# Enforce settings file permissions
N8N_ENFORCE_SETTINGS_FILE_PERMISSIONS=false

# Allow external modules
NODE_FUNCTION_ALLOW_EXTERNAL=playwright

# External task runner settings
# N8N_RUNNERS_ENABLED is not needed in n8n v2.x (auto-detected)
N8N_RUNNERS_MODE=external
# Required: shared secret between n8n and n8n-runners (openssl rand -hex 32)
N8N_RUNNERS_AUTH_TOKEN=
N8N_RUNNERS_BROKER_LISTEN_ADDRESS=0.0.0.0
N8N_RUNNERS_BROKER_PORT=5679
# Used by the n8n-runners sidecar
N8N_RUNNERS_TASK_BROKER_URI=http://n8n:5679

# Task runner memory settings
N8N_RUNNERS_MAX_OLD_SPACE_SIZE=3072
NODE_OPTIONS=--max-old-space-size=3072

# Required: Redis password (openssl rand -hex 32)
REDIS_PASSWORD=

# Redis connection settings
QUEUE_BULL_REDIS_HOST=redis
QUEUE_BULL_REDIS_PORT=6379
N8N_REDIS_TLS_ENABLED=false
N8N_REDIS_TLS_REJECT_UNAUTHORIZED=false
QUEUE_BULL_REDIS_CONNECT_TIMEOUT=50000
QUEUE_BULL_REDIS_RETRY_DELAY=5000
QUEUE_BULL_REDIS_MAX_ATTEMPTS=10
QUEUE_BULL_REDIS_DB=0

# Required: VNC password (max 8 characters, VNC protocol limit)
VNC_PASSWORD=
