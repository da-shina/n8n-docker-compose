# n8n 環境変数

# 重要: セキュアなランダムキーに置き換えてください (例: openssl rand -hex 32)
N8N_ENCRYPTION_KEY=

# 任意: タイムゾーンを設定してください (例: Europe/Berlin, America/New_York)
TZ=Asia/Tokyo

# 汎用タイムゾーン、通常はTZと同じです
GENERIC_TIMEZONE=${TZ}

# コミュニティノードを有効/無効にする
N8N_COMMUNITY_NODES_ENABLED=true

# コミュニティパッケージを指定してください。カンマ区切りで複数のパッケージを追加できます。
N8N_COMMUNITY_PACKAGES=n8n-nodes-playwright,@n8n/n8n-nodes-langchain

# ツールを使用するコミュニティパッケージをロード可能にします
N8N_COMMUNITY_PACKAGES_ALLOW_TOOL_USAGE=true

# 設定ファイルのパーミッションを強制します
N8N_ENFORCE_SETTINGS_FILE_PERMISSIONS=false

# データの保存先
N8N_USER_FOLDER=/home/pwuser/.n8n

# 外部モジュールの許可
NODE_FUNCTION_ALLOW_EXTERNAL=playwright

# タスクランナーの設定
N8N_RUNNERS_MAX_OLD_SPACE_SIZE=3072
N8N_RUNNERS_TASK_REQUEST_TIMEOUT=300000
N8N_JS_RUNNER_MODE=external
