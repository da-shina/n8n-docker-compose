# ==================== Single-Stage Build ====================

# Use a more recent Playwright base image
FROM mcr.microsoft.com/playwright:v1.51.1-jammy

# Install Node.js 22.x
RUN curl -fsSL https://deb.nodesource.com/setup_22.x | bash - && \
    apt-get update && apt-get install -y nodejs && \
    npm install -g npm@latest n8n@latest --no-audit --no-fund && \
    node --version && \
    npm cache clean --force

# Install additional system dependencies for GUI, VNC, and task runner environment
ENV DEBIAN_FRONTEND=noninteractive
ENV TZ=Asia/Tokyo
RUN ln -snf /usr/share/zoneinfo/$TZ /etc/localtime && echo $TZ > /etc/timezone
RUN apt-get update && apt-get install -y \
    dumb-init \
    x11vnc \
    xvfb \
    fluxbox \
    fonts-noto-cjk \
    python3 \
    python3-pip \
    python3-venv \
    tzdata \
    libatk1.0-0 \
    libatk-bridge2.0-0 \
    libcups2 \
    libnss3 \
    libgbm1 \
    libasound2 \
    libpangocairo-1.0-0 \
    libxss1 \
    libgtk-3-0 \
    && rm -rf /var/lib/apt/lists/*

# Install common Python packages for n8n Python nodes
RUN python3 -m pip install --upgrade pip --no-cache-dir && \
    python3 -m pip install pandas numpy openpyxl requests beautifulsoup4 --no-cache-dir

# Set n8n environment variables for proper task runner operation
ENV N8N_USER_FOLDER=/home/pwuser/.n8n
ENV N8N_RUNNERS_MODE=external
ENV N8N_RUNNERS_MAX_OLD_SPACE_SIZE=3072
ENV NODE_OPTIONS="--max-old-space-size=3072"
ENV DISPLAY=:99

# Create necessary directories
RUN mkdir -p /home/pwuser/.n8n /home/pwuser/user-data /tmp && \
    chown -R pwuser:pwuser /home/pwuser

# Copy the startup script
COPY --chmod=755 start.sh /app/start.sh

# Switch to pwuser
USER pwuser

WORKDIR /app

EXPOSE 5678 5900

# Set the entrypoint to run the startup script
ENTRYPOINT ["/usr/bin/dumb-init", "--"]
CMD ["/app/start.sh"]
