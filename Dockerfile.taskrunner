# ==================== シングルステージビルド ====================

# Playwright ベースイメージ: Chromium とブラウザ用システムライブラリを含む。
FROM mcr.microsoft.com/playwright:v1.51.1-jammy

# GUI、VNC、プロセス管理の依存関係をインストールする。
ENV DEBIAN_FRONTEND=noninteractive
ENV TZ=Asia/Tokyo
RUN ln -snf /usr/share/zoneinfo/$TZ /etc/localtime && echo $TZ > /etc/timezone && \
    apt-get update && apt-get install -y \
    dumb-init \
    x11vnc \
    xvfb \
    fluxbox \
    fonts-noto-cjk \
    tzdata \
    libatk1.0-0 \
    libatk-bridge2.0-0 \
    libcups2 \
    libnss3 \
    libgbm1 \
    libasound2 \
    libpangocairo-1.0-0 \
    libxss1 \
    libgtk-3-0 \
    && rm -rf /var/lib/apt/lists/*

# MCP サーバーが自分の Playwright バージョンに合うビルドを見つけられるよう、
# ブラウザを 1 つのパスにまとめる。@playwright/mcp はアルファ版の Playwright
# をリリースするため、ベースイメージにバンドルされたブラウザは再利用できない。
ENV PLAYWRIGHT_BROWSERS_PATH=/ms-playwright
RUN npm install -g @playwright/mcp --no-audit --no-fund && \
    node "$(npm root -g)/@playwright/mcp/node_modules/playwright/cli.js" install chromium && \
    npm cache clean --force

ENV DISPLAY=:99

# ブラウザプロファイル用の永続ディレクトリを作成する。
RUN mkdir -p /home/pwuser/user-data && \
    chown -R pwuser:pwuser /home/pwuser

# 起動スクリプトをコピーする (バインドマウントもあるため、再ビルドなしで編集が反映される)。
COPY --chmod=755 start.sh /app/start.sh

# pwuser に切り替える
USER pwuser

WORKDIR /app

EXPOSE 5900 8931

# エントリポイントとして起動スクリプトを設定する
ENTRYPOINT ["/usr/bin/dumb-init", "--"]
CMD ["/app/start.sh"]
