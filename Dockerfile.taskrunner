# ==================== Single-Stage Build ====================

# Playwright base image: includes Chromium and the browser system libraries.
FROM mcr.microsoft.com/playwright:v1.51.1-jammy

# Install the GUI, VNC and process-management dependencies.
ENV DEBIAN_FRONTEND=noninteractive
ENV TZ=Asia/Tokyo
RUN ln -snf /usr/share/zoneinfo/$TZ /etc/localtime && echo $TZ > /etc/timezone && \
    apt-get update && apt-get install -y \
    dumb-init \
    x11vnc \
    xvfb \
    fluxbox \
    fonts-noto-cjk \
    tzdata \
    libatk1.0-0 \
    libatk-bridge2.0-0 \
    libcups2 \
    libnss3 \
    libgbm1 \
    libasound2 \
    libpangocairo-1.0-0 \
    libxss1 \
    libgtk-3-0 \
    && rm -rf /var/lib/apt/lists/*

# Keep every browser under one path so the MCP server finds the build that
# matches its own Playwright version. @playwright/mcp ships alpha Playwright
# releases, so the browser bundled in the base image cannot be reused.
ENV PLAYWRIGHT_BROWSERS_PATH=/ms-playwright
RUN npm install -g @playwright/mcp --no-audit --no-fund && \
    node "$(npm root -g)/@playwright/mcp/node_modules/playwright/cli.js" install chromium && \
    npm cache clean --force

ENV DISPLAY=:99

# Create the persistent browser profile directory.
RUN mkdir -p /home/pwuser/user-data && \
    chown -R pwuser:pwuser /home/pwuser

# Copy the startup script (also bind-mounted so edits apply without a rebuild).
COPY --chmod=755 start.sh /app/start.sh

# Switch to pwuser
USER pwuser

WORKDIR /app

EXPOSE 5900 8931

# Set the entrypoint to run the startup script
ENTRYPOINT ["/usr/bin/dumb-init", "--"]
CMD ["/app/start.sh"]
